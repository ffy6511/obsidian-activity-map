{
	"name": "obsidian-activity-map",
	"version": "0.2.1",
	"description": "Track trustworthy Obsidian file activity and explore it by folder.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"check": "tsc --noEmit --skipLibCheck",
		"test": "node --import jiti/register tests/run.ts",
		"test:unit": "node --import jiti/register tests/run.ts",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"validate": "npm run check && npm run lint && npm run build",
		"prepare": "husky",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ffy6511/obsidian-activity-map.git"
	},
	"keywords": [
		"obsidian",
		"activity",
		"time-tracking",
		"productivity"
	],
	"author": "ffy6511",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/ffy6511/obsidian-activity-map/issues"
	},
	"homepage": "https://github.com/ffy6511/obsidian-activity-map#readme",
	"engines": {
		"node": ">=20.11.0"
	},
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.1",
		"husky": "^9.1.7",
		"jiti": "^2.6.1",
		"linkedom": "^0.18.13",
		"lint-staged": "^15.5.2",
		"obsidian": "latest",
		"prettier": "^3.9.6",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
